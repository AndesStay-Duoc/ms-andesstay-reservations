# Copiar a .env y completar. El archivo .env NO se versiona.
#
# Los nombres de abajo son los que el codigo lee de verdad. La version anterior de este archivo
# declaraba DB_URL, SVC_CATALOG_URL, KAFKA_BOOTSTRAP_SERVERS, JWT_ISSUER, JWT_AUDIENCE_STAFF y
# JWT_AUDIENCE_GUEST, que ninguna propiedad de application.yml consulta, y una URL de Oracle que
# ningun pom puede abrir: el unico driver declarado es mysql-connector-j.

# --- Base de datos (MySQL) ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/andesstay?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=andesstay
SPRING_DATASOURCE_PASSWORD=cambiar_esto

# --- Servicio de catalogo, para reservar y liberar cupo ---
CATALOG_BASE_URL=http://localhost:8082

# --- RabbitMQ ---
# Ojo: la propiedad lee RABBITMQ_PASS, no RABBITMQ_PASSWORD. El .env compartido de infra usa
# RABBITMQ_PASSWORD y el compose hace el mapeo entre ambos; para ejecutar el servicio de forma
# autonoma hay que definir RABBITMQ_PASS.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=andesstay
RABBITMQ_USER=andesstay
RABBITMQ_PASS=cambiar_esto

# --- Kafka ---
KAFKA_BOOTSTRAP=localhost:9092

# --- Publicacion de eventos: una bandera por broker ---
# La de RabbitMQ solo va en true si el 5672 responde: convertAndSend es SINCRONO y sin broker
# lanza AmqpConnectException, con lo que cada POST de reserva termina en 500.
ANDESSTAY_EVENTS_RABBIT_ENABLED=true
ANDESSTAY_EVENTS_KAFKA_ENABLED=false

# --- Identidad (Entra ID). No son secretos, son identificadores publicos del App Registration ---
AZURE_TENANT_ID=055d11d1-8ae0-4221-a6f7-b50be0a623b4
AZURE_CLIENT_ID=704a544f-3d92-44f5-aef9-8559574cff34
